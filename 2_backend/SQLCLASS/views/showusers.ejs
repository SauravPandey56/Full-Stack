<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALL Users</title>
    <style>
        table,th, td{
            border :1px solid black;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>Id</th>
            <th>Email</th>
            <th>Username</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
        
            <% for ( user of users) { %>
        <tr>
            <td><%= user.id %></td>
            <td><%= user.email %></td>
            <td><%= user.username %></td>
            <td>
                <form method="GET" action="/user/<%=user.id %>/edit" >
                <button>Edit uesrname</button>
            </form>
            </td>
        </tr>

            <!-- DELETE -->
            <td>
                <form method="GET" action="/user/<%= user.id %>/delete">
                    <button>Delete</button>
                </form>
            </td>

        </tr>

        
        <% } %>
    
    </table>

      <!-- ADD USER BUTTON - LOOP KE BAHAR -->
    <br>

    <form method="GET" action="/user/new">
        <button>Add New User</button>
    </form>

</body>
</html>